{
  "name": "ramayana-snakes-ladders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run lint && npm test && npm run sim && npm run build && npm run smoke",
    "sim": "tsx sim/simulate.ts",
    "art": "node scripts/art/gen.mjs public/assets",
    "art:check": "node scripts/art/check.mjs public/assets",
    "devices": "node scripts/devices.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
