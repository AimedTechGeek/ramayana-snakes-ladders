{
  "name": "ramayana-snakes-ladders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run lint && npm test && npm run sim && npm run build && npm run smoke",
    "sim": "tsx sim/simulate.ts",
    "devices": "node scripts/devices.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "blender:dice": "node scripts/blender/run.mjs scripts/blender/die.py public/models/dice/die.glb",
    "blender:props": "node scripts/blender/run.mjs scripts/blender/props.py public/models/props src/app/board3d/propsManifest.json",
    "blender:bridges": "tsx scripts/blender/bridges-build.mjs",
    "blender:snakes": "node scripts/blender/run.mjs scripts/blender/snakes.py public/models/snakes src/app/board3d/snakesManifest.json",
    "blender:board": "node scripts/blender/run.mjs scripts/blender/board.py public/models/board/board.glb",
    "blender:heroes": "node scripts/blender/heroes/build.mjs",
    "blender:heroes:check": "node scripts/blender/hero-check.mjs screenshots-tmp/heroes http://localhost:5311 all hanuman && node scripts/blender/hero-check.mjs screenshots-tmp/heroes-rama http://localhost:5311 all rama && node scripts/blender/hero-check.mjs screenshots-tmp/heroes-lakshmana http://localhost:5311 all lakshmana && node scripts/blender/hero-check.mjs screenshots-tmp/heroes-sita http://localhost:5311 all sita"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.179.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
