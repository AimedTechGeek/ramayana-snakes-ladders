{
  "rama.self.roll6": ["A six. Let us go on.", "Fortune favours patience.", "Once more, then."],
  "rama.self.ladder": ["A worthy step upward.", "Dharma lifts those who walk it.", "Onward, with gratitude."],
  "rama.self.ladderBig": ["What a blessing this is.", "The path opens wide today.", "Truly, the sages guide me."],
  "rama.self.snake": ["A setback. Nothing more.", "We rise again, calmly.", "Every exile ends in return."],
  "rama.self.snakeBig": ["Ravana's shadow is long.", "Fourteen years taught me patience.", "I will walk this road again."],
  "rama.self.overtake": ["Forgive me as I pass, friend.", "The road is wide enough for all.", "Keep pace, we go together."],
  "rama.self.overtaken": ["Well moved, my friend.", "Go ahead; I follow in time.", "Your stride is swift today."],
  "rama.self.nearMiss": ["Close, but the bow held true.", "Steady breath, steady feet.", "Danger passed. We go on."],
  "rama.self.waiting": ["Ayodhya waits. So shall I.", "The throne is near. Patience.", "Each roll in its own time."],
  "rama.self.tripleSix": ["Too much haste. I yield the turn.", "Even sixes must rest.", "A lesson in restraint."],
  "rama.self.win": ["Ayodhya, I have come home.", "Well played, all of you.", "This joy belongs to us all."],
  "rama.self.lose": ["Congratulations, my friend!", "A victory well earned.", "You honoured the game. Bravo."],

  "rama.other.roll6": ["Well rolled.", "Fortune smiles on you.", "Go on, the turn is yours."],
  "rama.other.ladder": ["A fine ascent, friend.", "Climb well.", "You walk a good path."],
  "rama.other.ladderBig": ["Remarkable! Well climbed.", "The heavens favour you.", "A leap worthy of song."],
  "rama.other.snake": ["Courage. It is only a step back.", "Rise again, friend.", "The road returns to you."],
  "rama.other.snakeBig": ["Hold steady. This too passes.", "I have known such falls.", "Your strength is not lost."],
  "rama.other.overtake": ["Go well, friend. I follow.", "Swift feet! Well done.", "The lead is yours for now."],
  "rama.other.overtaken": ["It is only a game, friend.", "Your turn will come again.", "Patience. The road is long."],
  "rama.other.nearMiss": ["Well escaped.", "That was close, friend.", "Fortune guarded you."],
  "rama.other.waiting": ["The throne is near for you.", "Patience, friend. Almost there.", "Every roll counts now."],
  "rama.other.tripleSix": ["Haste undoes us all.", "Next turn, friend.", "A pause, not a defeat."],
  "rama.other.win": ["Congratulations, my friend!", "A worthy victory.", "You have reached the throne!"],
  "rama.other.lose": ["Well played, all the same.", "There is honour in the effort.", "We shall play again."],

  "sita.self.roll6": ["A six. The earth is kind.", "Let us keep walking.", "One more step, gently."],
  "sita.self.ladder": ["The path rises gently.", "How lovely, a way upward.", "I am grateful for this."],
  "sita.self.ladderBig": ["Oh! The sky draws nearer.", "What a gift this climb is.", "Mithila would smile at this."],
  "sita.self.snake": ["A small sorrow. It will pass.", "I have waited before.", "Let us go quietly on."],
  "sita.self.snakeBig": ["Even Lanka could not break me.", "Hope does not fall with me.", "I will find my way back."],
  "sita.self.overtake": ["Pardon me, dear friend.", "May we both reach the end.", "I pass with a kind heart."],
  "sita.self.overtaken": ["Go gently, friend.", "I am happy for you.", "The road keeps us close."],
  "sita.self.nearMiss": ["That was close. I am well.", "A calm heart steadies the feet.", "The danger has passed."],
  "sita.self.waiting": ["So near, yet patience first.", "I will wait, as I always have.", "The throne can wait a turn."],
  "sita.self.tripleSix": ["Three sixes. I will rest.", "Haste is not my way.", "Next turn, then."],
  "sita.self.win": ["Home, at last, together.", "Thank you, dear friends.", "Mithila's daughter is home."],
  "sita.self.lose": ["Well done, dear friend.", "Your victory warms my heart.", "A game well played by all."],

  "sita.other.roll6": ["Good fortune to you.", "A lovely roll.", "Keep going, friend."],
  "sita.other.ladder": ["How wonderful for you.", "Climb gently and well.", "Up you go, friend."],
  "sita.other.ladderBig": ["Oh, how beautifully you rise!", "A blessing on your path.", "What a joyful leap!"],
  "sita.other.snake": ["Do not lose heart.", "I am here, friend.", "You will rise again soon."],
  "sita.other.snakeBig": ["Be gentle with yourself.", "This too shall pass, friend.", "Your courage remains."],
  "sita.other.overtake": ["Well done, go ahead.", "How swift you are.", "The lead suits you."],
  "sita.other.overtaken": ["Take heart, friend.", "Your time will come.", "No race is lost so soon."],
  "sita.other.nearMiss": ["Oh, that was close!", "Thank goodness.", "The earth held you safe."],
  "sita.other.waiting": ["Almost there, friend.", "Breathe. The throne waits.", "Patience, it is near."],
  "sita.other.tripleSix": ["Oh dear. Next time.", "Rest now, roll later.", "Be patient, friend."],
  "sita.other.win": ["Congratulations, friend!", "What a joyful ending.", "The throne is yours!"],
  "sita.other.lose": ["You played with grace.", "There will be another game.", "Well done, all the same."],

  "lakshmana.self.roll6": ["A six! Again, quickly!", "Ha! Stand aside!", "The dice obey me today."],
  "lakshmana.self.ladder": ["Up! No time to waste!", "Finally, some progress.", "Climb faster, feet!"],
  "lakshmana.self.ladderBig": ["Now THIS is a bridge!", "Out of my way, I'm flying!", "Brother, did you see that?"],
  "lakshmana.self.snake": ["Grr! Treachery!", "Who put this snake here?!", "Not fair! Not fair at all!"],
  "lakshmana.self.snakeBig": ["No! All that climbing!", "I'll cut that snake in half!", "This is Ravana's doing!"],
  "lakshmana.self.overtake": ["Move aside! Coming through!", "Ha! The wind is with me!", "Faster, feet! Faster!"],
  "lakshmana.self.overtaken": ["Hey! Get back here!", "Hmph. I'll catch up.", "You just wait!"],
  "lakshmana.self.nearMiss": ["Ha! Missed me, serpent!", "Phew. Too close.", "Nice try, snake!"],
  "lakshmana.self.waiting": ["Hurry up, dice!", "I can't stand this waiting!", "So close! Roll already!"],
  "lakshmana.self.tripleSix": ["WHAT? Three sixes and nothing?!", "Who made these rules?!", "Grr! I'll sit. For now."],
  "lakshmana.self.win": ["Victory! For Rama!", "Ha! Told you I'd win!", "Fastest to the throne!"],
  "lakshmana.self.lose": ["Hmph. Fine. Well played.", "Rematch. Right now.", "Next time I win, you'll see!"],

  "lakshmana.other.roll6": ["Lucky roll. Just luck.", "Hmph, a six. Big deal.", "Fine, go again."],
  "lakshmana.other.ladder": ["Not bad. Not bad at all.", "Hurry up and climb, then.", "Good. Keep moving."],
  "lakshmana.other.ladderBig": ["WHAT? That's a huge jump!", "Lucky! Just lucky!", "Fine, I'm impressed. A bit."],
  "lakshmana.other.snake": ["Grr! That sneaky snake!", "Snakes everywhere, I told you.", "Careful, friend."],
  "lakshmana.other.snakeBig": ["Ouch. That hurt to watch.", "I warned you about this forest!", "Get up! We go again!"],
  "lakshmana.other.overtake": ["Hey, no overtaking!", "Hmph. Not for long!", "I'm right behind you!"],
  "lakshmana.other.overtaken": ["Don't just stand there!", "Catch up! Quickly!", "Hmph. Happens to everyone."],
  "lakshmana.other.nearMiss": ["Lucky escape!", "Careful! That was close!", "I saw that snake twitch."],
  "lakshmana.other.waiting": ["Hurry up already!", "Just roll the number!", "How long must we wait?!"],
  "lakshmana.other.tripleSix": ["Ha! Greedy dice!", "Those dice have no manners!", "Three sixes? Unlucky."],
  "lakshmana.other.win": ["Fine. Well played. Hmph.", "You won. This time.", "Congratulations, I suppose."],
  "lakshmana.other.lose": ["Chin up. Rematch soon.", "You fought well, friend.", "Next game, we win!"],

  "bharata.self.roll6": ["A six. I accept it humbly.", "Another step, in Rama's name.", "Gently, once more."],
  "bharata.self.ladder": ["A step closer to my brother.", "I climb only to serve.", "The padukas lead the way."],
  "bharata.self.ladderBig": ["Brother, I am coming to you.", "Such grace. I have not earned it.", "The padukas' blessing lifts me."],
  "bharata.self.snake": ["A setback. I bear it calmly.", "I have waited longer than this.", "Patience. I keep the faith."],
  "bharata.self.snakeBig": ["Fourteen years I waited. I can wait.", "Back I go, the padukas safe.", "Sorrow, but no bitterness."],
  "bharata.self.overtake": ["Forgive me, I pass with respect.", "I go ahead only to serve.", "Pardon my haste."],
  "bharata.self.overtaken": ["Go ahead. I gladly follow.", "Well moved. The lead is yours.", "I am happy to walk behind."],
  "bharata.self.nearMiss": ["A close call. The padukas kept me.", "Grace held me back from harm.", "Safe. I give thanks."],
  "bharata.self.waiting": ["Ayodhya is near. I wait.", "The throne is Rama's, not mine.", "I have kept this vigil before."],
  "bharata.self.tripleSix": ["Too eager. I yield the turn.", "Even devotion needs restraint.", "I sit and wait, gladly."],
  "bharata.self.win": ["I have kept the throne for Rama.", "The padukas are home at last.", "This joy is my brother's."],
  "bharata.self.lose": ["Congratulations! Well deserved.", "Well won. I rejoice for you.", "A worthy victory. Bravo!"],

  "bharata.other.roll6": ["Well rolled, friend.", "Go on, with my blessing.", "A good six."],
  "bharata.other.ladder": ["A fine climb.", "May the road rise for you.", "Well done, friend."],
  "bharata.other.ladderBig": ["Wonderful! Well climbed.", "What a blessing for you.", "Truly, a climb to remember."],
  "bharata.other.snake": ["Take heart. You will rise.", "A step back, nothing more.", "Patience brings us home."],
  "bharata.other.snakeBig": ["I am sorry. Hold steady.", "Long roads still end at home.", "Your strength remains."],
  "bharata.other.overtake": ["Well moved, friend.", "Swift and steady. Well done.", "Go well. We follow."],
  "bharata.other.overtaken": ["Be at peace. It is a game.", "Your turn will return.", "Patience, friend."],
  "bharata.other.nearMiss": ["Thank goodness. Safe.", "Well escaped, friend.", "Grace guarded you."],
  "bharata.other.waiting": ["The throne is near you now.", "Steady, friend. Almost.", "One true roll will do."],
  "bharata.other.tripleSix": ["A pause, nothing more.", "Rest a moment, friend.", "Next turn will be kinder."],
  "bharata.other.win": ["Congratulations, friend!", "Ayodhya rejoices for you!", "A worthy victory!"],
  "bharata.other.lose": ["Well played, all the same.", "You played with honour.", "We will play again."],

  "shatrughna.self.roll6": ["A six! Let's go, let's go!", "Yes! Again, quickly!", "The dice like me today!"],
  "shatrughna.self.ladder": ["Up I go! Wait for me!", "Climbing! Bharata, look!", "Ha! Up and onward!"],
  "shatrughna.self.ladderBig": ["Whoa! Look how high I am!", "Brothers, did you see that?!", "I'm almost at the clouds!"],
  "shatrughna.self.snake": ["Hey! Where did that come from?!", "Oof! Sneaky snake!", "Back down? Already?!"],
  "shatrughna.self.snakeBig": ["No, no, no! All that way!", "That snake is Ravana's spy!", "Grr! I'll climb it all again!"],
  "shatrughna.self.overtake": ["Coming through! Sorry!", "Ha! Watch me go!", "Can't stop me now!"],
  "shatrughna.self.overtaken": ["Hey! Wait for me!", "I'll catch you, just watch!", "Not fair, I was winning!"],
  "shatrughna.self.nearMiss": ["Whoa! Missed me, snake!", "Phew! My heart!", "Ha! Too quick for you!"],
  "shatrughna.self.waiting": ["Come on, come on, dice!", "So close! I can't sit still!", "Roll the right one, please!"],
  "shatrughna.self.tripleSix": ["Three sixes?! Oh, come on!", "Too fast again. Oops.", "Fine, fine. I'll wait."],
  "shatrughna.self.win": ["I won! For Ayodhya!", "The youngest wins! Ha!", "Brothers, I made it!"],
  "shatrughna.self.lose": ["Well played! You earned it!", "Aw. Again? Please?", "Next time I'll be faster!"],

  "shatrughna.other.roll6": ["Nice six! Go again!", "Lucky! Roll, roll!", "Ooh, a six!"],
  "shatrughna.other.ladder": ["Yes! Up you go!", "Good climb! Keep going!", "Nice one!"],
  "shatrughna.other.ladderBig": ["Whoa! What a climb!", "That was amazing!", "So high! Well done!"],
  "shatrughna.other.snake": ["Oh no! That sneaky snake!", "Don't worry, climb again!", "Bad snake! Shoo!"],
  "shatrughna.other.snakeBig": ["Ouch! Hold on, you'll rise!", "That snake! I'm so sorry!", "Up again! I'll cheer you on!"],
  "shatrughna.other.overtake": ["Wow, so fast!", "Go, go, go!", "Zoom! Nice move!"],
  "shatrughna.other.overtaken": ["Don't worry, catch up!", "Quick, after them!", "Chin up! Still time!"],
  "shatrughna.other.nearMiss": ["Phew! That was close!", "Whoa! Lucky escape!", "Careful! Snakes about!"],
  "shatrughna.other.waiting": ["Come on, roll it!", "So close! You can do it!", "I can't watch! Roll!"],
  "shatrughna.other.tripleSix": ["Three sixes! Oh no!", "Greedy dice, that's all.", "Next turn, for sure!"],
  "shatrughna.other.win": ["Hooray! You did it!", "Congratulations! Wonderful!", "A win! Let's celebrate!"],
  "shatrughna.other.lose": ["Good game, everyone!", "Next time we all go faster!", "That was fun! Again?"],

  "bharata.to.rama.ladderBig": ["Well climbed, my elder brother!", "Brother, the road rises for you."],
  "bharata.to.rama.snakeBig": ["Brother, your padukas wait for you.", "Even this, brother, you will bear."],
  "bharata.to.rama.win": ["Brother, the throne is yours again!", "Ayodhya welcomes you home!"],
  "bharata.to.lakshmana.ladderBig": ["Well climbed, Lakshmana!", "Your loyalty lifts you, brother."],
  "bharata.to.lakshmana.snakeBig": ["Steady, Lakshmana. No anger.", "Rise again, brave brother."],
  "bharata.to.lakshmana.win": ["Congratulations, Lakshmana!", "You guarded Rama; now you win!"],
  "bharata.to.shatrughna.ladderBig": ["Well climbed, little brother!", "Gently, Shatrughna, but well done."],
  "bharata.to.shatrughna.snakeBig": ["Take my hand, Shatrughna.", "Calm, little brother. We rise."],
  "bharata.to.shatrughna.win": ["Congratulations, Shatrughna!", "My faithful brother wins!"],
  "shatrughna.to.rama.ladderBig": ["Brother Rama, you're flying!", "Look how high you climbed!"],
  "shatrughna.to.rama.snakeBig": ["Don't worry, brother! We'll rise!", "That snake will answer to me!"],
  "shatrughna.to.rama.win": ["Hooray! Brother Rama is home!", "Brother Rama is king again!"],
  "shatrughna.to.lakshmana.ladderBig": ["Lakshmana, wait for me!", "Race you to the top, brother!"],
  "shatrughna.to.lakshmana.snakeBig": ["Oof! I'll help you, brother!", "Grr! Get that snake, Lakshmana!"],
  "shatrughna.to.lakshmana.win": ["Lakshmana wins! Hooray!", "Well done, brother! You did it!"],
  "shatrughna.to.bharata.ladderBig": ["Bharata, that was wonderful!", "Well climbed, brother Bharata!"],
  "shatrughna.to.bharata.snakeBig": ["I'm with you, Bharata!", "The padukas are safe, brother!"],
  "shatrughna.to.bharata.win": ["Bharata wins! I knew it!", "Brother, Ayodhya cheers you!"],
  "rama.to.bharata.ladderBig": ["Well climbed, dear Bharata.", "Your devotion lifts you, brother."],
  "rama.to.bharata.snakeBig": ["Courage, Bharata. I am here.", "You have borne far more, brother."],
  "rama.to.bharata.win": ["Congratulations, Bharata!", "No one deserves it more, brother!"],
  "rama.to.shatrughna.ladderBig": ["A fine climb, Shatrughna.", "Well done, youngest brother."],
  "rama.to.shatrughna.snakeBig": ["Rise again, Shatrughna.", "Steady, brother. The road returns."],
  "rama.to.shatrughna.win": ["Congratulations, Shatrughna!", "Well won, my brother!"],
  "lakshmana.to.bharata.ladderBig": ["Hmph. Well climbed, Bharata.", "Fine climb, brother. Truly."],
  "lakshmana.to.bharata.snakeBig": ["Grr! Leave Bharata alone, snake!", "Up, brother! I've got you!"],
  "lakshmana.to.bharata.win": ["Well played, Bharata. Truly.", "You won, brother. Fair and square."],
  "lakshmana.to.shatrughna.ladderBig": ["Hey! Not so fast, little one!", "Ha! That's my little brother!"],
  "lakshmana.to.shatrughna.snakeBig": ["That snake! I'll cut it in half!", "Up, Shatrughna! We go again!"],
  "lakshmana.to.shatrughna.win": ["Hmph. The little one wins!", "Fine! Well played, Shatrughna!"],

  "hanuman.self.roll6": ["Six! Watch me hop!", "Wheee! Again, again!", "My tail is tingling!"],
  "hanuman.self.ladder": ["Up, up, up I go!", "Bridges? I prefer leaping!", "Hooray, a shortcut!"],
  "hanuman.self.ladderBig": ["I'm FLYING! Look at me!", "Over the ocean in one bound!", "Mountains? Easy. Watch this!"],
  "hanuman.self.snake": ["Oops! Slipped on a snake!", "Hey! That tickles!", "Down I go, wheee... oh no."],
  "hanuman.self.snakeBig": ["Waaah! My tail! My tail!", "Whoops. Big slide, big splash.", "Ravana, you sneaky fellow!"],
  "hanuman.self.overtake": ["Coming through! Beep beep!", "Hop, skip, and past you!", "Catch me if you can!"],
  "hanuman.self.overtaken": ["Hey! Wait for Hanuman!", "No fair, I blinked!", "Ooh, fast feet! I'll catch up!"],
  "hanuman.self.nearMiss": ["Phew! Tail still attached!", "Ha! Missed me by a whisker!", "That snake needs glasses!"],
  "hanuman.self.waiting": ["Almost there! Hurry, dice!", "I can SEE the throne from here!", "Come on, come on, come on!"],
  "hanuman.self.tripleSix": ["Three sixes? Too much power!", "Oops. Got too excited.", "Even monkeys need a breather."],
  "hanuman.self.win": ["Jai Shri Ram! We did it!", "Hanuman wins! Whoop whoop!", "Coronation time! Sweets for all!"],
  "hanuman.self.lose": ["Well played! Let's go again!", "You win! I'll bring the sweets.", "Next time I'll leap faster!"],

  "hanuman.other.roll6": ["Ooh, a six! Lucky you!", "Roll again, roll again!", "My turn next, please!"],
  "hanuman.other.ladder": ["Climb, climb, climb!", "Hooray for bridges!", "Nice one! Up you go!"],
  "hanuman.other.ladderBig": ["WOW! Were you flying?!", "That's MY kind of jump!", "Teach me that trick!"],
  "hanuman.other.snake": ["Oops! Watch your tail!", "Snake got you! Shake it off!", "Boo, you sneaky snake!"],
  "hanuman.other.snakeBig": ["Ooooh. That's a long slide.", "I felt that from here!", "Don't worry, I've fallen too!"],
  "hanuman.other.overtake": ["Zoom! Look at them go!", "Hey, no fair, so fast!", "Speedy! I like it!"],
  "hanuman.other.overtaken": ["Don't worry, keep hopping!", "They'll slow down, I bet!", "You'll catch them, friend!"],
  "hanuman.other.nearMiss": ["Phew! That was close!", "The snake blinked first!", "Ha! Lucky, lucky!"],
  "hanuman.other.waiting": ["Roll the number! Roll it!", "So close, I can't sit still!", "Ooh, ooh, come on!"],
  "hanuman.other.tripleSix": ["Three sixes! Greedy dice!", "Ha! Too much excitement!", "Happens to the best of us!"],
  "hanuman.other.win": ["Hooray! Congratulations!", "Jai! Sweets for everyone!", "You won! Let's dance!"],
  "hanuman.other.lose": ["Good game, friend!", "Cheer up, I'll do a flip!", "Next time, we leap together!"],

